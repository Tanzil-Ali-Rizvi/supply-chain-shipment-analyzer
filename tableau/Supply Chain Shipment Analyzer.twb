hift01].[sum:saving_musd:qk]' /></encodings><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /><format attr='mark-labels-cull' value='true' /><format attr='mark-color' value='#0f766e' /></style-rule></style></pane></panes><rows>[federated.modeshift01].[none:country:nk]</rows><cols>[federated.modeshift01].[sum:saving_musd:qk]</cols></table><simple-id uuid='{9356CFE2-BEB4-5679-8135-579EE230451A}' /></worksheet></worksheets><dashboards><dashboard name='Delivery &amp; Freight Overview'><style><style-rule element='table'><format attr='background-color' value='#faf7f2' /></style-rule></style><size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' sizing-mode='fixed' /><datasources /><zones><zone h='100000' id='112' type-v2='layout-basic' w='100000' x='0' y='0'><zone floating='true' h='9400' w='97714' x='1143' y='1000' id='101' type-v2='text'><formatted-text><run bold='true' fontcolor='#ffffff' fontsize='17'>Supply Chain Shipment Analyzer</run><run>Æ&#10;</run><run fontcolor='#e6fffa' fontsize='10'>Where does a global health supply chain lose time and money, and what should it fix first? 10,324 line items to 43 countries, 2006-2015 (USAID SCMS data).</run></formatted-text><zone-style><format attr='border-color' value='#134e4a' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='10' /><format attr='background-color' value='#134e4a' /></zone-style></zone><zone floating='true' h='10400' w='18971' x='1143' y='11200' id='102' name='KPI On-time' show-title='false'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='10400' w='18971' x='20829' y='11200' id='103' name='KPI Value late' show-title='false'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='10400' w='18971' x='40514' y='11200' id='104' name='KPI Warehouse vs direct' show-title='false'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='10400' w='18971' x='60200' y='11200' id='105' name='KPI Air share' show-title='false'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='10400' w='18971' x='79886' y='11200' id='106' name='KPI Mode shift' show-title='false'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='32400' w='48571' x='1143' y='22600' id='107' name='Late rate by year' show-title='true'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='32400' w='48571' x='50286' y='22600' id='108' name='Lanes by value late' show-title='true'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='32600' w='48571' x='1143' y='55800' id='109' name='Late rate by country' show-title='true'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='32600' w='48571' x='50286' y='55800' id='110' name='Freight cost by mode' show-title='true'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='9600' w='97714' x='1143' y='89200' id='111' type-v2='text'><formatted-text><run bold='true' fontcolor='#1c1917' fontsize='10'>What this solves. </run><run fontcolor='#57534e' fontsize='9'>$259.0M of medicines arrived late, and the regional-warehouse route is late 17.2% of the time vs 5.3% direct (6.1x odds in the same country, year and mode). Act first on warehouse dispatch in Mozambique, Nigeria and Zambia; ship heavy orders placed 180+ days ahead by sea; batch sub-100 kg orders. Questions answered: how reliable is delivery, which route and lanes lose the most stock, what freight costs by mode and size, and what a mode shift would save.</run></formatted-text><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='10' /><format attr='background-color' value='#ffffff' /></zone-style></zone></zone></zones><simple-id uuid='{9971DD12-D608-504C-88C8-66CB189B4CEE}' /></dashboard><dashboard name='Freight, Vendors &amp; Mode Shift'><style><style-rule element='table'><format attr='background-color' value='#faf7f2' /></style-rule></style><size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' sizing-mode='fixed' /><datasources /><zones><zone h='100000' id='118' type-v2='layout-basic' w='100000' x='0' y='0'><zone floating='true' h='9400' w='97714' x='1143' y='1000' id='113' type-v2='text'><formatted-text><run bold='true' fontcolor='#ffffff' fontsize='17'>Freight, Vendors &amp; Mode Shift</run><run>Æ&#10;</run><run fontcolor='#e6fffa' fontsize='10'>Air is 62.5% of the $68.7M freight bill; shipping 140 heavy, early-planned air orders by sea saves about $1.73M.</run></formatted-text><zone-style><format attr='border-color' value='#134e4a' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='10' /><format attr='background-color' value='#134e4a' /></zone-style></zone><zone floating='true' h='38000' w='48571' x='1143' y='11400' id='114' name='Cost per kg by size' show-title='true'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='38000' w='48571' x='50286' y='11400' id='115' name='Mode-shift saving by country' show-title='true'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='39000' w='97714' x='1143' y='50200' id='116' name='Vendor scorecard' show-title='true'><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone floating='true' h='8800' w='97714' x='1143' y='90000' id='117' type-v2='text'><formatted-text><run bold='true' fontcolor='#1c1917' fontsize='10'>How to read it. </run><run fontcolor='#57534e' fontsize='9'>Freight is analysed per shipment (it is recorded once per ASN/DN). Vendor scorecard covers direct shipments from vendors with 20+ line items. Every number comes from the governed Python metrics in the GitHub repo (Tanzil-Ali-Rizvi/supply-chain-shipment-analyzer), and the extract reconciles to them.</run></formatted-text><zone-style><format attr='border-color' value='#e7e5e4' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='10' /><format attr='background-color' value='#ffffff' /></zone-style></zone></zone></zones><simple-id uuid='{284F73DF-2E6F-514D-9A81-6E351B862FA3}' /></dashboard></dashboards><windows source-height='30'><window class='worksheet' hidden='true' maximized='true' name='KPI On-time'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{12669ECB-DD78-568E-B0FE-BF37F0312BEC}' /></window><window class='worksheet' hidden='true' maximized='true' name='KPI Value late'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{2BCE9E23-0051-5778-8C15-38A532659D68}' /></window><window class='worksheet' hidden='true' maximized='true' name='KPI Warehouse vs direct'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{176C542D-8D55-5A7C-8572-80779FF63E21}' /></window><window class='worksheet' hidden='true' maximized='true' name='KPI Air share'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{AF671DB6-DA01-53FE-8E1E-FE3AE655BD71}' /></window><window class='worksheet' hidden='true' maximized='true' name='KPI Mode shift'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{1812D5D5-06C9-51E7-9C30-C82D5F26D941}' /></window><window class='worksheet' hidden='true' maximized='true' name='Late rate by year'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{2E274BB4-25F6-5106-86EA-01E6F81A6F5B}' /></window><window class='worksheet' hidden='true' maximized='true' name='Lanes by value late'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{384235F4-9188-5A11-8FF0-3BE16D5564A9}' /></window><window class='worksheet' hidden='true' maximized='true' name='Late rate by country'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{50C6F9A7-8471-5ED1-B57C-51302191032E}' /></window><window class='worksheet' hidden='true' maximized='true' name='Freight cost by mode'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{46137B68-A3EE-5E86-B24A-4568A598EADF}' /></window><window class='worksheet' hidden='true' maximized='true' name='Cost per kg by size'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{BB11190E-D395-5038-B372-68231FAF14DB}' /></window><window class='worksheet' hidden='true' maximized='true' name='Vendor scorecard'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid='{FB0BF637-CD6A-5E6B-98EF-09C2F84BAFCF}' /></window><window class='worksheet' hidden='true' maximized='true' name='Mode-shift saving by country'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='