d:nk]</cols></table><simple-id uuid='{1B1E895E-6861-54EF-9C68-C0142B1ED317}' /></worksheet><worksheet name='Vendor scorecard'><layout-options><title><formatted-text><run bold='true' fontcolor='#1c1917' fontname='Tableau Medium' fontsize='12'>Direct-ship vendors: volume vs late rate (bubble = commodity value)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption='Vendor scorecard' name='federated.vendors01' /></datasources><datasource-dependencies datasource='federated.vendors01'><column caption='Late rate' datatype='real' default-format='p0%' name='[late_rate]' role='measure' type='quantitative' /><column caption='Line items' datatype='integer' name='[lines]' role='measure' type='quantitative' /><column caption='Commodity value ($M)' datatype='real' default-format='n#,##0.0' name='[value_musd]' role='measure' type='quantitative' /><column caption='Vendor' datatype='string' name='[vendor]' role='dimension' type='nominal' /><column-instance column='[late_rate]' derivation='Avg' name='[avg:late_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[vendor]' derivation='None' name='[none:vendor:nk]' pivot='key' type='nominal' /><column-instance column='[lines]' derivation='Sum' name='[sum:lines:qk]' pivot='key' type='quantitative' /><column-instance column='[value_musd]' derivation='Sum' name='[sum:value_musd:qk]' pivot='key' type='quantitative' /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='table'><format attr='background-color' value='#ffffff' /></style-rule><style-rule element='worksheet'><format attr='font-family' value='Tableau Book' /><format attr='color' value='#57534e' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Circle' /><encodings><size column='[federated.vendors01].[sum:value_musd:qk]' /><lod column='[federated.vendors01].[none:vendor:nk]' /><text column='[federat